    def set_connection_manager(self, conn_manager):
        import sys
        import os
        root_dir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
        robot_console_dir = os.path.join(root_dir, "Robot-Console")
        if robot_console_dir not in sys.path:
            sys.path.insert(0, robot_console_dir)
        try:
            from services.video_broadcaster import VideoBroadcastService
        except (ImportError, ModuleNotFoundError):
            import importlib.util
            vb_path = os.path.join(robot_console_dir, "services", "video_broadcaster.py")
            if os.path.exists(vb_path):
                spec = importlib.util.spec_from_file_location("services.video_broadcaster", vb_path)
                vb_mod = importlib.util.module_from_spec(spec)
                spec.loader.exec_module(vb_mod)
                VideoBroadcastService = vb_mod.VideoBroadcastService
            else:
                raise

        self.broadcaster = VideoBroadcastService(conn_manager=conn_manager, parent=self)
        self.broadcaster.fps_updated.connect(self._on_broadcaster_fps)
        self.broadcaster.status_changed.connect(self._on_status)

    def _on_broadcaster_fps(self, fps):

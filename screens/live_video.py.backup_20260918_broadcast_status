    def set_session_info(self, session_id: str, username: str = "", role: str = ""):
        """Initialize session metadata and start continuous session recording."""
        self._session_id = session_id
        self._username = username
        self._role = role
        if hasattr(self, 'recorder'):
            self.start_session(session_id=session_id)

    def start_session(self, session_id: str = None):
        """Start a clinical session and begin session recording."""
        if session_id:
            self._session_id = session_id
        elif not self._session_id:
            import uuid
            self._session_id = f"SES-{uuid.uuid4().hex[:8].upper()}"

        if hasattr(self, 'recorder'):
            if self.recorder.state != STATE_RECORDING:
                self.recorder.start_recording(
                    session_id=self._session_id,
                    username=self._username,
                    role=self._role,
                )
        self.status_label.setText(f"Session {self._session_id} active - Recording")
        self.message_center.add_message(f"Session {self._session_id} started")

    def stop_session(self):
        """End the current session and stop/export recording."""
        if not hasattr(self, 'recorder'):
            return
        if self.recorder.state == STATE_RECORDING:
            self.message_center.add_message(f"Ending session {self._session_id}...")
            self._export_session()
        elif self.recorder.state in (STATE_EXPORTED, STATE_ERROR):
            self._export_session()
        else:
            self.status_label.setText("No active session to stop")

    def record_alert(self, alert_dict: dict):
        """Record an alert event into the session recorder."""
        if hasattr(self, 'recorder'):
            self.recorder.record_alert(alert_dict)

    def _on_record_session_clicked(self):
        """Handle clicking the primary record session control."""
        if not hasattr(self, 'recorder'):
            return
        if self.recorder.state == STATE_IDLE:
            self.start_session(session_id=self._session_id)
        elif self.recorder.state == STATE_RECORDING:
            self.stop_session()
        elif self.recorder.state in (STATE_EXPORTED, STATE_ERROR):
            self._export_session()

    def _toggle_recording(self):
        """Backward-compatible alias for record session action."""
        self._on_record_session_clicked()

    def _export_session(self):
        """Trigger session recording finalization and PDF summary export."""
        if not hasattr(self, 'recorder'):
            return
        if self.recorder.state == STATE_FINALIZING:
            return

        self.status_label.setText("Exporting session (generating MP4 + PDF)...")
        self.message_center.add_message("Session export initiated...")
        self.recorder.export_session()

    def _on_export_started(self):
        self.status_label.setText("Exporting session...")

    def _on_export_finished(self, mp4_path: str, pdf_path: str):
        self.status_label.setText("Session exported successfully")
        self.message_center.add_message(
            f"Export complete: {os.path.basename(mp4_path) if mp4_path else 'No video'}, "
            f"{os.path.basename(pdf_path)}"
        )
        duration = self.recorder.get_session_data().get("duration", "00:00:00")
        dialog = SessionExportDialog(
            session_id=self.recorder.get_session_data().get("session_id", self._session_id),
            mp4_path=mp4_path,
            pdf_path=pdf_path,
            duration=duration,
            parent=self,
        )
        dialog.exec()

    def _on_export_failed(self, error_msg: str):
        self.status_label.setText(f"Export failed: {error_msg}")
        self.message_center.add_message(f"Export error: {error_msg}")

        QMessageBox.warning(
            self,
            "Session Export Failed",
            f"Failed to export session:\n\n{error_msg}"
        )

    def _on_recorder_state(self, state: str):
        """Update buttons, badges, styles, and status labels to match the real recorder state."""

        # Update the permanent global sidebar using the real recorder state.
        main_window = self.window()
        if hasattr(main_window, 'sidebar'):
            recording_status = {
                STATE_RECORDING: "green",
                STATE_FINALIZING: "yellow",
                STATE_ERROR: "red",
                STATE_EXPORTED: "grey",
                STATE_IDLE: "grey",
            }.get(state, "grey")
            main_window.sidebar.set_system_status(
                "Recording",
                recording_status
            )


    def _update_joystick_controls(self):
        """Handle Thrustmaster virtual camera controls and buttons."""
        if not hasattr(self, "joystick") or not self.joystick.connected:
            return

        # Axis 0 -> virtual horizontal pan.
        # Axis 1 -> virtual vertical pan.
        pan_x = self.joystick.read_pan_x()
        pan_y = self.joystick.read_pan_y()

        self.canvas.set_virtual_pan(pan_x, pan_y)

        # Axis 2 -> virtual video rotation.
        rotation = self.joystick.get_rotation()
        self.canvas.set_rotation(rotation)

        # Axis 3 -> existing Live Video zoom.
        zoom = self.joystick.get_zoom()
        slider_value = int(round(zoom * 10))

        if self.zoom_slider.value() != slider_value:
            self.zoom_slider.setValue(slider_value)

        # Mirror the virtual camera state into any visible fullscreen view.
        for viewer_name in (
            "_assisted_fullscreen_viewer",
            "_original_fullscreen_viewer",
        ):
            viewer = getattr(self, viewer_name, None)

            if viewer is not None and viewer.isVisible():
                viewer.canvas._zoom = self.canvas._zoom
                viewer.canvas._pan_offset = QPointF(
                    self.canvas._pan_offset
                )
                viewer.canvas._rotation = self.canvas._rotation
                viewer.canvas._clamp_pan()
                viewer.canvas.update()

        # Button presses are edge-triggered so holding a button does
        # not repeatedly trigger the associated action.
        button_actions = {
            9: self._broadcast_camera,  # Physical button 10
            10: self._toggle_yolo,      # Physical button 11
            11: self._stop_video,       # Physical button 12
        }

        for button_index, action in button_actions.items():
            pressed = self.joystick.is_button_pressed(button_index)
            previous = self._joystick_buttons.get(button_index, False)

            if pressed and not previous:
                action()

            self._joystick_buttons[button_index] = pressed

    def _on_zoom_slider(self, value):
        self.zoom = value / 10.0
        self.canvas.set_zoom(self.zoom)
        self._update_zoom_ui()

    def _apply_zoom(self):
        self.canvas.set_zoom(self.zoom)
        self.zoom_slider.blockSignals(True)
        self.zoom_slider.setValue(int(self.zoom * 10))
        self.zoom_slider.blockSignals(False)
        self._update_zoom_ui()

    def _update_zoom_ui(self):
        self.zoom_value_lbl.setText(f"{self.zoom:.1f}\u00D7")
        roi = round(100 / self.zoom)
        self.roi_lbl.setText(f"ZOOM {self.zoom:.1f}\u00D7  \u00B7  ROI {roi}%")
        self.btn_zoom_out.setEnabled(self.zoom > self.ZOOM_MIN)
        self.btn_zoom_in.setEnabled(self.zoom < self.ZOOM_MAX)


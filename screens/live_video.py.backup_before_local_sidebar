class _VitalSparkline(QWidget):
    """Small live trend graph for one patient vital."""

    def __init__(self, parent=None):
        super().__init__(parent)
        self._values = []
        self.setMinimumHeight(22)
        self.setMaximumHeight(22)

    def set_value(self, value):
        try:
            number = float(value)
        except (TypeError, ValueError):
            return

        self._values.append(number)

        # Keep the graph compact and recent.
        self._values = self._values[-30:]
        self.update()

    def clear(self):
        self._values.clear()
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)

        w = max(1, self.width())
        h = max(1, self.height())

        # Baseline
        p.setPen(QPen(QColor("#263244"), 1))
        p.drawLine(0, h - 2, w, h - 2)

        if len(self._values) < 2:
            p.end()
            return

        low = min(self._values)
        high = max(self._values)

        if abs(high - low) < 0.001:
            low -= 1.0
            high += 1.0

        points = []

        for i, value in enumerate(self._values):
            x = (
                i * (w - 2) / max(len(self._values) - 1, 1)
            ) + 1

            normalized = (value - low) / (high - low)
            y = (h - 3) - normalized * (h - 6)

            points.append(QPointF(x, y))

        pen = QPen(QColor("#38BDF8"), 1.5)
        pen.setCapStyle(Qt.PenCapStyle.RoundCap)
        pen.setJoinStyle(Qt.PenJoinStyle.RoundJoin)
        p.setPen(pen)

        for i in range(1, len(points)):
            p.drawLine(points[i - 1], points[i])

        p.end()



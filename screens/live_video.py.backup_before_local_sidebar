            }
            QPushButton:disabled {
                background-color: #0F172A;
                color: #64748B;
                border-color: #1E293B;
            }
        """)

        mp4_ok = bool(mp4_path and os.path.isfile(mp4_path) and os.path.getsize(mp4_path) > 0)
        pdf_ok = bool(pdf_path and os.path.isfile(pdf_path) and os.path.getsize(pdf_path) > 0)
        is_full_success = mp4_ok and pdf_ok

        lay = QVBoxLayout(self)
        lay.setSpacing(14)
        lay.setContentsMargins(22, 20, 22, 20)

        # Header Title
        title_text = "SESSION EXPORT COMPLETE" if is_full_success else "SESSION EXPORT (PARTIAL)"
        title_color = "#10B981" if is_full_success else "#F59E0B"
        title_lbl = QLabel(title_text)
        title_lbl.setStyleSheet(f"font-size: 16px; font-weight: 800; color: {title_color};")
        lay.addWidget(title_lbl)

        if not is_full_success:
            err_box = QLabel("PDF generated successfully, but video export failed or contains no recorded frames.")
            err_box.setWordWrap(True)
            err_box.setStyleSheet("color: #EF4444; font-size: 12px; font-weight: 600;")
            lay.addWidget(err_box)

        # Details Grid Frame
        grid_frame = QFrame()
        grid_frame.setStyleSheet("background-color: #1E293B; border-radius: 6px; border: 1px solid #334155;")
        glay = QGridLayout(grid_frame)
        glay.setContentsMargins(12, 10, 12, 10)
        glay.setHorizontalSpacing(14)
        glay.setVerticalSpacing(8)

        def _add_row(r, label, val):
            l = QLabel(label)
            l.setStyleSheet("color: #94A3B8; font-size: 11px; font-weight: 700;")
            v = QLabel(val)
            v.setStyleSheet("color: #F8FAFC; font-size: 12px; font-weight: 600;")
            v.setWordWrap(True)
            glay.addWidget(l, r, 0)
            glay.addWidget(v, r, 1)

        _add_row(0, "SESSION ID:", session_id or "N/A")
        _add_row(1, "DURATION:", duration or "00:00:00")
        _add_row(2, "VIDEO FILE:", os.path.basename(mp4_path) if mp4_ok else "No video recorded")
        _add_row(3, "PDF REPORT:", os.path.basename(pdf_path) if pdf_ok else "PDF missing")
        lay.addWidget(grid_frame)

        # Action Buttons
        btn_lay = QHBoxLayout()
        btn_lay.setSpacing(8)

        btn_open_video = QPushButton("OPEN VIDEO")
        btn_open_video.setEnabled(mp4_ok)
        btn_open_video.clicked.connect(lambda: self._open_file(mp4_path))
        btn_lay.addWidget(btn_open_video)

        btn_open_pdf = QPushButton("OPEN PDF")
        btn_open_pdf.setEnabled(pdf_ok)
        btn_open_pdf.clicked.connect(lambda: self._open_file(pdf_path))
        btn_lay.addWidget(btn_open_pdf)

        btn_open_folder = QPushButton("OPEN FOLDER")
        folder = os.path.dirname(pdf_path) if pdf_path else os.path.dirname(mp4_path)
        btn_open_folder.setEnabled(bool(folder and os.path.isdir(folder)))
        btn_open_folder.clicked.connect(lambda: self._open_folder(folder))
        btn_lay.addWidget(btn_open_folder)

        btn_close = QPushButton("CLOSE")
        btn_close.clicked.connect(self.accept)
        btn_lay.addWidget(btn_close)

        lay.addLayout(btn_lay)

    def _open_file(self, file_path: str):
        if not file_path or not os.path.exists(file_path):
            return
        import subprocess
        if sys.platform == "win32":
            os.startfile(file_path)
        elif sys.platform == "darwin":
            subprocess.Popen(["open", file_path])
        else:
            subprocess.Popen(["xdg-open", file_path])

    def _open_folder(self, folder_path: str):
        if not folder_path or not os.path.exists(folder_path):
            return
        import subprocess
        if sys.platform == "win32":
            os.startfile(folder_path)
        elif sys.platform == "darwin":
            subprocess.Popen(["open", folder_path])
        else:
            subprocess.Popen(["xdg-open", folder_path])



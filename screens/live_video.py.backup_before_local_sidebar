    def _zoom_in(self):
        self.zoom = min(self.ZOOM_MAX, round(self.zoom + self.ZOOM_STEP, 2))
        self._apply_zoom()

    def _zoom_out(self):
        self.zoom = max(self.ZOOM_MIN, round(self.zoom - self.ZOOM_STEP, 2))

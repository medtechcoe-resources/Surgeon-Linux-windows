/* ============================================================
   AETHER SURGICAL CONSOLE — DARK THEME (default)
   Medical-grade premium dark palette
   3440x1440 Ultrawide Optimised
   ============================================================ */

/* ---------- Global ---------- */
QWidget {
    background-color: #0D1117;
    color: #E6EDF3;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #0D1117;
}

/* CRITICAL: All QLabel backgrounds must be transparent by default */
QLabel {
    background-color: transparent;
    color: #E6EDF3;
}

/* ---------- Header ---------- */
#Header {
    background-color: #0D1117;
    border-bottom: 1px solid #1C2333;
}
#BrandTitle {
    font-size: 18px;
    font-weight: 700;
    color: #F5F7FA;
    letter-spacing: 1.5px;
    background: transparent;
}
#BrandSubtitle {
    font-size: 11px;
    color: #6B7B8D;
    letter-spacing: 1.2px;
    font-weight: 500;
    background: transparent;
}
#HeaderChip {
    background-color: #161B22;
    border: 1px solid #1C2333;
    border-radius: 8px;
}
#HeaderChipLabel {
    color: #6B7B8D;
    font-size: 10px;
    letter-spacing: 1px;
    font-weight: 600;
    background: transparent;
}
#HeaderChipValue {
    color: #F5F7FA;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#HeaderChipValueAccent {
    color: #0095FF;
    font-size: 14px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#SystemActiveLabel {
    color: #10B981;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#ThemeToggle {
    background-color: #161B22;
    border: 1px solid #1C2333;
    border-radius: 8px;
    color: #F5F7FA;
    font-weight: 600;
    font-size: 13px;
    padding: 10px 18px;
}
#ThemeToggle:hover {
    border-color: #0095FF;
    background-color: #1C2333;
}
#LogoBadge {
    background-color: #0D2818;
    border: 2px solid #10B981;
    border-radius: 10px;
}

/* ---------- Nav Tabs ---------- */
#NavBar {
    background-color: #0D1117;
    border-bottom: 1px solid #1C2333;
}
QPushButton[class="NavTab"] {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #6B7B8D;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 6px;
    text-align: left;
}
QPushButton[class="NavTab"]:hover {
    color: #B5BEC8;
}
QPushButton[class="NavTab"][active="true"] {
    color: #F5F7FA;
    font-weight: 600;
    border-bottom: 2px solid #0095FF;
}

/* ---------- Cards ---------- */
#Card {
    background-color: #171C22;
    border: none;
    border-radius: 10px;
}
#Card[accent="green"]  { border-left: 3px solid #10B981; }
#Card[accent="amber"]  { border-left: 3px solid #F59E0B; }
#Card[accent="cyan"]   { border-left: 3px solid #0095FF; }
#Card[accent="red"]    { border-left: 3px solid #EF4444; }
#Card[accent="purple"] { border-left: 3px solid #8B5CF6; }

#CardLabel {
    color: #6B7B8D;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.8px;
    background: transparent;
}
#CardValue {
    color: #F5F7FA;
    font-size: 26px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#CardSub {
    color: #6B7B8D;
    font-size: 11px;
    background: transparent;
}

#SectionTitle {
    color: #B5BEC8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
#PanelTitle {
    color: #F5F7FA;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}
#SectionHeaderBar {
    background-color: #131820;
    border: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
#PanelBody {
    background-color: #171C22;
    border: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ---------- Sidebar ---------- */
#SidebarCard {
    background-color: #171C22;
    border: none;
    border-radius: 10px;
}
#SidebarCardTitle {
    color: #6B7B8D;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
#PatientAvatar {
    background-color: #0D2818;
    border: 2px solid #10B981;
    border-radius: 10px;
    color: #10B981;
    font-weight: 700;
    font-size: 16px;
}
#PatientName {
    color: #F5F7FA;
    font-size: 16px;
    font-weight: 700;
    background: transparent;
}
#PatientMeta {
    color: #6B7B8D;
    font-size: 11px;
    background: transparent;
}
#FieldLabel {
    color: #6B7B8D;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}
#FieldValue {
    color: #E6EDF3;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#FieldValueBold {
    color: #F5F7FA;
    font-size: 14px;
    font-weight: 700;
    background: transparent;
}
#FieldValueWarn {
    color: #F59E0B;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
QFrame#HLine {
    background-color: #1C2333;
    max-height: 1px;
    min-height: 1px;
}

/* ---------- Status Bar ---------- */
#StatusBar {
    background-color: #090D12;
    border-top: 1px solid #1C2333;
}
#StatusBarText {
    color: #6B7B8D;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

/* ---------- Primary Buttons ---------- */
QPushButton[class="PrimaryButton"] {
    background-color: #0095FF;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="PrimaryButton"]:hover {
    background-color: #1AA3FF;
}
QPushButton[class="PrimaryButton"]:pressed {
    background-color: #0077CC;
}
QPushButton[class="PrimaryButton"]:disabled {
    background-color: #1C2333;
    color: #4A5568;
}

/* ---------- Secondary Buttons ---------- */
QPushButton[class="SecondaryButton"] {
    background-color: transparent;
    border: 1px solid #2D3748;
    border-radius: 7px;
    color: #B5BEC8;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="SecondaryButton"]:hover {
    border-color: #0095FF;
    color: #F5F7FA;
    background-color: #161B22;
}
QPushButton[class="SecondaryButton"]:pressed {
    background-color: #1C2333;
}
QPushButton[class="SecondaryButton"]:disabled {
    border-color: #1C2333;
    color: #4A5568;
}

/* ---------- Danger Buttons ---------- */
QPushButton[class="DangerButton"] {
    background-color: #EF4444;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="DangerButton"]:hover {
    background-color: #F87171;
}
QPushButton[class="DangerButton"]:pressed {
    background-color: #DC2626;
}
QPushButton[class="DangerButton"]:disabled {
    background-color: #3D1517;
    color: #7A3235;
}

/* ---------- Toggle Buttons ---------- */
QPushButton[class="ToggleButton"] {
    background-color: #0D2818;
    border: 1.5px solid #10B981;
    border-radius: 7px;
    color: #10B981;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="ToggleButton"]:hover {
    background-color: #0A3020;
    border-color: #34D399;
    color: #34D399;
}
QPushButton[class="ToggleButton"][active="true"] {
    background-color: #2C0A0A;
    border-color: #EF4444;
    color: #EF4444;
}
QPushButton[class="ToggleButton"][active="true"]:hover {
    background-color: #3D1515;
    border-color: #F87171;
    color: #F87171;
}
QPushButton[class="ToggleButton"][active="true"][accent="blue"] {
    background-color: #0D1B2A;
    border-color: #0095FF;
    color: #0095FF;
}
QPushButton[class="ToggleButton"][active="true"][accent="purple"] {
    background-color: #1A0D2E;
    border-color: #8B5CF6;
    color: #8B5CF6;
}

/* ---------- Grid/Icon Buttons ---------- */
QPushButton[class="GridButton"] {
    background-color: #161B22;
    border: 1px solid #2D3748;
    border-radius: 7px;
    color: #B5BEC8;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 10px;
}
QPushButton[class="GridButton"]:hover {
    border-color: #0095FF;
    color: #F5F7FA;
    background-color: #1C2333;
}
QPushButton[class="GridButton"][active="true"] {
    background-color: #0095FF;
    color: #FFFFFF;
    border-color: #0095FF;
}

/* ---------- Pedal Buttons ---------- */
QPushButton[class="PedalButton"] {
    background-color: #171C22;
    border: 1.5px solid #2D3748;
    border-radius: 8px;
    color: #B5BEC8;
    font-size: 13px;
    font-weight: 700;
    padding: 12px;
    min-height: 44px;
}
QPushButton[class="PedalButton"]:hover {
    border-color: #0095FF;
    color: #F5F7FA;
    background-color: #1C2333;
}
QPushButton[class="PedalButton"]:pressed {
    background-color: #0D1B2A;
    border-color: #0095FF;
    color: #0095FF;
}
QPushButton[class="PedalButton"][active="true"] {
    background-color: #0D2818;
    border-color: #10B981;
    color: #10B981;
}

/* ---------- Emergency Stop ---------- */
QPushButton#EStop {
    background-color: #C91C1C;
    border: 2px solid #F87171;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 0px 12px;
    min-height: 44px;
    min-width: 160px;
}
QPushButton#EStop:hover {
    background-color: #EF4444;
    border-color: #FCA5A5;
}
QPushButton#EStop:pressed {
    background-color: #991B1B;
}

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
    height: 5px;
    background: #1C2333;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #0095FF;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #F5F7FA;
    border: 2px solid #0095FF;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}
QSlider::groove:horizontal:disabled {
    background: #131820;
}
QSlider::sub-page:horizontal:disabled {
    background: #2D3748;
}
QSlider::handle:horizontal:disabled {
    background: #2D3748;
    border-color: #1C2333;
}

/* ---------- Progress Bars ---------- */
QProgressBar {
    background-color: #1C2333;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #10B981;
    border-radius: 3px;
}
QProgressBar[level="caution"]::chunk { background-color: #F59E0B; }
QProgressBar[level="critical"]::chunk { background-color: #EF4444; }

/* ---------- Tables ---------- */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: #1C2333;
    color: #E6EDF3;
    font-size: 13px;
    selection-background-color: #1C2333;
}
QTableWidget::item {
    border-bottom: 1px solid #1C2333;
    padding: 6px;
    background: transparent;
}
QHeaderView::section {
    background-color: transparent;
    color: #6B7B8D;
    border: none;
    border-bottom: 1px solid #1C2333;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #2D3748;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #4A5568;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #2D3748;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Telemetry Values ---------- */
#TelemetryValue {
    color: #F5F7FA;
    font-size: 26px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#TelemetryUnit {
    color: #6B7B8D;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}
#TelemetryLabel {
    color: #6B7B8D;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}

/* ---------- Vital Display ---------- */
#VitalValue {
    color: #F5F7FA;
    font-size: 28px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#VitalLabel {
    color: #6B7B8D;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}
#VitalUnit {
    color: #6B7B8D;
    font-size: 12px;
    background: transparent;
}

/* ---------- Status Indicators ---------- */
#StatusGood {
    color: #10B981;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#StatusCaution {
    color: #F59E0B;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#StatusCritical {
    color: #EF4444;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

/* ---------- Detection Info Row ---------- */
#DetectRowLabel {
    background-color: transparent;
    color: #6B7B8D;
    font-size: 12px;
    font-weight: 500;
}
#DetectRowValue {
    background-color: transparent;
    color: #F5F7FA;
    font-size: 13px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
#SliderLabel {
    background-color: transparent;
    color: #6B7B8D;
    font-size: 12px;
    font-weight: 500;
}
#SliderValue {
    background-color: transparent;
    color: #0095FF;
    font-size: 12px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    min-width: 46px;
}

/* ---------- Misc ---------- */
.TextMuted  { color: #6B7B8D; }
.TextAccent { color: #0095FF; }
.TextGood   { color: #10B981; }
.TextWarn   { color: #F59E0B; }
.TextBad    { color: #EF4444; }

QToolTip {
    background-color: #1C2333;
    color: #F5F7FA;
    border: 1px solid #2D3748;
    border-radius: 6px;
    padding: 8px;
    font-size: 12px;
}

/* ---------- Compact Action Buttons (Live Video) ---------- */
QPushButton[class="CompactAction"] {
    background-color: #171C22;
    border: 1px solid #2D3748;
    border-radius: 6px;
    color: #B5BEC8;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 10px;
    min-height: 30px;
}
QPushButton[class="CompactAction"]:hover {
    border-color: #0095FF;
    color: #F5F7FA;
    background-color: #1C2333;
}
QPushButton[class="CompactAction"][active="true"] {
    background-color: #0D2818;
    border-color: #10B981;
    color: #10B981;
}

/* ---------- Pause / Play Overlay Button ---------- */
QPushButton#PauseOverlay {
    background-color: rgba(13, 17, 23, 160);
    border: 1px solid rgba(45, 55, 72, 180);
    border-radius: 8px;
    color: #F5F7FA;
    font-size: 14px;
    font-weight: 700;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
}
QPushButton#PauseOverlay:hover {
    background-color: rgba(28, 35, 51, 200);
    border-color: #0095FF;
}

/* ---------- Detection Metric Cards ---------- */
#MetricSummaryCard {
    background-color: #171C22;
    border: none;
    border-left: 3px solid #0095FF;
    border-radius: 7px;
}
#MetricSummaryTitle {
    background-color: transparent;
    color: #6B7B8D;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.4px;
}
#MetricSummaryValue {
    background-color: transparent;
    color: #F5F7FA;
    font-size: 18px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
#MetricSummarySub {
    background-color: transparent;
    color: #4A5568;
    font-size: 10px;
    font-weight: 500;
}

/* ---------- Message Center ---------- */
#MessageCard {
    background-color: #171C22;
    border: none;
    border-radius: 8px;
}
#MessageCardTitle {
    background-color: transparent;
    color: #B5BEC8;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}
#MessageItem {
    background-color: #131820;
    border: none;
    border-radius: 4px;
}
#MessageItemLatest {
    background-color: #0D1B2A;
    border: 1px solid #0095FF;
    border-radius: 4px;
}
#MessageText {
    background-color: transparent;
    color: #B5BEC8;
    font-size: 11px;
    font-weight: 500;
}
#MessageTextLatest {
    background-color: transparent;
    color: #F5F7FA;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- System Status Card ---------- */
#SystemStatusCard {
    background-color: #171C22;
    border: none;
    border-radius: 8px;
}
#SystemStatusLabel {
    background-color: transparent;
    color: #6B7B8D;
    font-size: 12px;
    font-weight: 500;
}
#SystemStatusValue {
    background-color: transparent;
    font-size: 12px;
    font-weight: 700;
}

/* ---------- Surgery Notes ---------- */
QTextEdit#SurgeryNotes {
    background-color: #131820;
    color: #E6EDF3;
    border: 1px solid #2D3748;
    border-radius: 7px;
    padding: 10px;
    font-size: 13px;
    font-family: "Inter", "Segoe UI", sans-serif;
    selection-background-color: #0095FF;
}
QTextEdit#SurgeryNotes:focus {
    border-color: #0095FF;
}

/* ---------- Sidebar Section Title ---------- */
#SidebarSectionTitle {
    background-color: transparent;
    color: #4A5568;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

/* ---------- Foot Pedal Flat Buttons ---------- */
QPushButton[class="FlatPedal"] {
    background-color: #171C22;
    border: 1px solid #2D3748;
    border-radius: 7px;
    color: #B5BEC8;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
    min-height: 34px;
    letter-spacing: 0.3px;
}
QPushButton[class="FlatPedal"]:hover {
    border-color: #4A5568;
    color: #F5F7FA;
    background-color: #1C2333;
}
QPushButton[class="FlatPedal"][active="true"] {
    background-color: #0D2818;
    border-color: #10B981;
    color: #10B981;
}
QPushButton[class="FlatPedalCoag"] {
    background-color: #1E1600;
    border: 1px solid #F59E0B;
    border-radius: 7px;
    color: #F59E0B;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
    min-height: 34px;
}
QPushButton[class="FlatPedalCoag"]:hover {
    border-color: #FBBF24;
    background-color: #2A1E00;
}
QPushButton[class="FlatPedalCoag"][active="true"] {
    background-color: #F59E0B;
    color: #0D1117;
}

/* ---------- Broadcast Button ---------- */
QPushButton[class="BroadcastButton"] {
    background-color: #0D2818;
    border: 1.5px solid #10B981;
    border-radius: 7px;
    color: #10B981;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="BroadcastButton"]:hover {
    background-color: #0A3020;
    border-color: #34D399;
    color: #34D399;
}
QPushButton[class="BroadcastButton"][active="true"] {
    background-color: #2C0A0A;
    border-color: #EF4444;
    color: #EF4444;
}
QPushButton[class="BroadcastButton"][active="true"]:hover {
    background-color: #3D1515;
    border-color: #F87171;
    color: #F87171;
}
QPushButton[class="BroadcastButton"]:disabled {
    background-color: #1C2333;
    border-color: #2D3748;
    color: #4A5568;
}

/* ═══════════════════════════════════════════════
   PRE-OP IMAGING WORKSPACE STYLES
   ═══════════════════════════════════════════════ */

/* Scan type selector container */
#ScanSelectorContainer {
    background-color: #131820;
    border: 1px solid #1C2333;
    border-radius: 8px;
}

/* MRI / CT tab buttons */
QPushButton[class="ScanTab"] {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #6B7B8D;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    letter-spacing: 0.5px;
    min-height: 34px;
}
QPushButton[class="ScanTab"]:hover {
    color: #B5BEC8;
    background-color: #1C2333;
}
QPushButton[class="ScanTab"][active="true"] {
    background-color: #0095FF;
    color: #FFFFFF;
    font-weight: 700;
}

/* Medical image viewer frame */
#MedicalViewer {
    background-color: #000000;
    border: 1px solid #1C2333;
    border-radius: 8px;
}

/* Viewer control buttons */
QPushButton[class="ViewerControl"] {
    background-color: #161B22;
    border: 1px solid #2D3748;
    border-radius: 5px;
    color: #B5BEC8;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    min-height: 28px;
}
QPushButton[class="ViewerControl"]:hover {
    border-color: #0095FF;
    color: #F5F7FA;
    background-color: #1C2333;
}

/* Load image button (Pre-Op) */
QPushButton[class="LoadImageButton"] {
    background-color: #0D1B2A;
    border: 1px solid #0095FF;
    border-radius: 6px;
    color: #0095FF;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 16px;
    min-height: 32px;
    letter-spacing: 0.3px;
}
QPushButton[class="LoadImageButton"]:hover {
    background-color: #0095FF;
    color: #FFFFFF;
}

/* Dermoscopic image viewer */
#DermoscopicViewer {
    background-color: #0D1117;
    border: 1px solid #1C2333;
    border-radius: 7px;
}

/* Pre-Op info panel sections */
#InfoSectionTitle {
    color: #4A5568;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: transparent;
}
#InfoSectionCard {
    background-color: #131820;
    border: none;
    border-radius: 8px;
    border-left: 2px solid #1C2333;
}

/* Image status label */
#ImageStatusLabel {
    color: #10B981;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
#ImageStatusLabelIdle {
    color: #4A5568;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* Modality title in viewer */
#ViewerModalityTitle {
    color: #0095FF;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
#ViewerMetaLabel {
    color: #4A5568;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* ═══════════════════════════════════════════════
   LIVE STATUS SECTION (Live Video left panel)
   ═══════════════════════════════════════════════ */
#LiveStatusSection {
    background-color: #131820;
    border: none;
    border-radius: 7px;
}
#LiveStatusTitle {
    color: #4A5568;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}

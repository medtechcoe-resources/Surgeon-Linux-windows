/* ============================================================
   AETHER SURGICAL CONSOLE — LIGHT THEME
   Medical-grade professional palette  ·  Premium UI redesign
   ============================================================ */

/* ---------- Global ---------- */
QWidget {
    background-color: #F1F5F9;
    color: #0F172A;
    font-family: "Inter", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #F1F5F9;
}

/* CRITICAL: All QLabel backgrounds must be transparent by default */
QLabel {
    background-color: transparent;
    color: #0F172A;
}

/* ---------- Header ---------- */
#Header {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}
#BrandTitle {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
    letter-spacing: 1px;
    background: transparent;
}
#BrandSubtitle {
    font-size: 10px;
    color: #64748B;
    letter-spacing: 0.8px;
    font-weight: 500;
    background: transparent;
}
#HeaderChip {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}
#HeaderChipLabel {
    color: #94A3B8;
    font-size: 9px;
    letter-spacing: 0.8px;
    font-weight: 600;
    background: transparent;
}
#HeaderChipValue {
    color: #0F172A;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#HeaderChipValueAccent {
    color: #0077CC;
    font-size: 13px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#SystemActiveLabel {
    color: #059669;
    font-size: 12px;
    font-weight: 700;
    background: transparent;
}
#ThemeToggle {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    color: #0F172A;
    font-weight: 600;
    font-size: 12px;
    padding: 7px 14px;
}
#ThemeToggle:hover {
    border-color: #0077CC;
    background-color: #EFF8FF;
}
#LogoBadge {
    background-color: #ECFDF5;
    border: 2px solid #059669;
    border-radius: 8px;
}

/* ---------- Nav Tabs ---------- */
#NavBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}
QPushButton[class="NavTab"] {
    background-color: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 6px;
    text-align: left;
}
QPushButton[class="NavTab"]:hover {
    color: #1E293B;
}
QPushButton[class="NavTab"][active="true"] {
    color: #0F172A;
    font-weight: 600;
    border-bottom: 2px solid #0077CC;
}

/* ---------- Cards ---------- */
#Card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}
#Card[accent="green"]  { border-left: 3px solid #059669; }
#Card[accent="amber"]  { border-left: 3px solid #D97706; }
#Card[accent="cyan"]   { border-left: 3px solid #0077CC; }
#Card[accent="red"]    { border-left: 3px solid #DC2626; }
#Card[accent="purple"] { border-left: 3px solid #7C3AED; }

#CardLabel {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}
#CardValue {
    color: #0F172A;
    font-size: 24px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#CardSub {
    color: #64748B;
    font-size: 11px;
    background: transparent;
}

#SectionTitle {
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}
#PanelTitle {
    color: #0F172A;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.3px;
    background: transparent;
}
#SectionHeaderBar {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}
#PanelBody {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-top: none;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
}

/* ---------- Sidebar ---------- */
#SidebarCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
}
#SidebarCardTitle {
    color: #94A3B8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
    background: transparent;
}
#PatientAvatar {
    background-color: #EFF8FF;
    border: 2px solid #0077CC;
    border-radius: 8px;
    color: #0077CC;
    font-weight: 700;
    font-size: 14px;
}
#PatientName {
    color: #0F172A;
    font-size: 15px;
    font-weight: 700;
    background: transparent;
}
#PatientMeta {
    color: #64748B;
    font-size: 11px;
    background: transparent;
}
#FieldLabel {
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
    background: transparent;
}
#FieldValue {
    color: #1E293B;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}
#FieldValueBold {
    color: #0F172A;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#FieldValueWarn {
    color: #D97706;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
QFrame#HLine {
    background-color: #F1F5F9;
    max-height: 1px;
    min-height: 1px;
}

/* ---------- Status Bar ---------- */
#StatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #E2E8F0;
}
#StatusBarText {
    color: #64748B;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.5px;
    background: transparent;
}

/* ---------- Primary Buttons ---------- */
QPushButton[class="PrimaryButton"] {
    background-color: #0077CC;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="PrimaryButton"]:hover {
    background-color: #0095FF;
}
QPushButton[class="PrimaryButton"]:pressed {
    background-color: #005EA3;
}
QPushButton[class="PrimaryButton"]:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* ---------- Secondary Buttons ---------- */
QPushButton[class="SecondaryButton"] {
    background-color: transparent;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    color: #475569;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="SecondaryButton"]:hover {
    border-color: #0077CC;
    color: #0F172A;
    background-color: #EFF8FF;
}
QPushButton[class="SecondaryButton"]:pressed {
    background-color: #E2E8F0;
}
QPushButton[class="SecondaryButton"]:disabled {
    border-color: #E2E8F0;
    color: #CBD5E1;
}

/* ---------- Danger Buttons ---------- */
QPushButton[class="DangerButton"] {
    background-color: #DC2626;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="DangerButton"]:hover {
    background-color: #EF4444;
}
QPushButton[class="DangerButton"]:pressed {
    background-color: #B91C1C;
}
QPushButton[class="DangerButton"]:disabled {
    background-color: #FECACA;
    color: #F87171;
}

/* ---------- Toggle Buttons ---------- */
QPushButton[class="ToggleButton"] {
    background-color: #ECFDF5;
    border: 1.5px solid #059669;
    border-radius: 7px;
    color: #059669;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="ToggleButton"]:hover {
    background-color: #D1FAE5;
    border-color: #047857;
    color: #047857;
}
QPushButton[class="ToggleButton"][active="true"] {
    background-color: #FEF2F2;
    border-color: #DC2626;
    color: #DC2626;
}
QPushButton[class="ToggleButton"][active="true"]:hover {
    background-color: #FEE2E2;
    border-color: #B91C1C;
    color: #B91C1C;
}
QPushButton[class="ToggleButton"][active="true"][accent="blue"] {
    background-color: #EFF8FF;
    border-color: #0077CC;
    color: #0077CC;
}
QPushButton[class="ToggleButton"][active="true"][accent="purple"] {
    background-color: #F5F3FF;
    border-color: #7C3AED;
    color: #7C3AED;
}

/* ---------- Broadcast Button ---------- */
QPushButton[class="BroadcastButton"] {
    background-color: #059669;
    border: none;
    border-radius: 7px;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 18px;
    min-height: 36px;
}
QPushButton[class="BroadcastButton"]:hover {
    background-color: #047857;
}
QPushButton[class="BroadcastButton"][active="true"] {
    background-color: #DC2626;
}
QPushButton[class="BroadcastButton"][active="true"]:hover {
    background-color: #B91C1C;
}
QPushButton[class="BroadcastButton"]:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* ---------- Grid/Icon Buttons ---------- */
QPushButton[class="GridButton"] {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 10px;
}
QPushButton[class="GridButton"]:hover {
    border-color: #0077CC;
    color: #0F172A;
    background-color: #EFF8FF;
}
QPushButton[class="GridButton"][active="true"] {
    background-color: #0077CC;
    color: #FFFFFF;
    border-color: #0077CC;
}

/* ---------- Pedal Buttons ---------- */
QPushButton[class="PedalButton"] {
    background-color: #F8FAFC;
    border: 1.5px solid #CBD5E1;
    border-radius: 8px;
    color: #475569;
    font-size: 13px;
    font-weight: 700;
    padding: 12px;
    min-height: 44px;
}
QPushButton[class="PedalButton"]:hover {
    border-color: #0077CC;
    color: #0F172A;
    background-color: #EFF8FF;
}
QPushButton[class="PedalButton"]:pressed {
    background-color: #DBEAFE;
    border-color: #0077CC;
    color: #0077CC;
}
QPushButton[class="PedalButton"][active="true"] {
    background-color: #ECFDF5;
    border-color: #059669;
    color: #059669;
}

/* ---------- Compact Action Buttons ---------- */
QPushButton[class="ClutchButton"] {
    background-color: #EFF8FF;
    border: 1.5px solid #0077CC;
    border-radius: 7px;
    color: #0077CC;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 12px;
    min-height: 34px;
}
QPushButton[class="ClutchButton"][active="true"] {
    background-color: #0077CC;
    color: #FFFFFF;
}
QPushButton[class="ClutchButton"]:hover { background-color: #DBEAFE; }

QPushButton[class="CoagButton"] {
    background-color: #FFFBEB;
    border: 1.5px solid #D97706;
    border-radius: 7px;
    color: #D97706;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 12px;
    min-height: 34px;
}
QPushButton[class="CoagButton"][active="true"] {
    background-color: #D97706;
    color: #FFFFFF;
}
QPushButton[class="CoagButton"]:hover { background-color: #FEF3C7; }

QPushButton[class="CutButton"] {
    background-color: #FEF2F2;
    border: 1.5px solid #DC2626;
    border-radius: 7px;
    color: #DC2626;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 12px;
    min-height: 34px;
}
QPushButton[class="CutButton"][active="true"] {
    background-color: #DC2626;
    color: #FFFFFF;
}
QPushButton[class="CutButton"]:hover { background-color: #FEE2E2; }

/* ---------- Emergency Stop ---------- */
QPushButton#EStop {
    background-color: #B91C1C;
    border: 2px solid #EF4444;
    border-radius: 6px;
    color: #FFFFFF;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 0px 12px;
    min-height: 44px;
    min-width: 160px;
}
QPushButton#EStop:hover {
    background-color: #DC2626;
    border-color: #F87171;
}
QPushButton#EStop:pressed {
    background-color: #991B1B;
}

/* ---------- Sliders ---------- */
QSlider::groove:horizontal {
    height: 5px;
    background: #E2E8F0;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #0077CC;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 2px solid #0077CC;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover {
    background: #EFF8FF;
}
QSlider::groove:horizontal:disabled {
    background: #E2E8F0;
}
QSlider::sub-page:horizontal:disabled {
    background: #CBD5E1;
}
QSlider::handle:horizontal:disabled {
    background: #E2E8F0;
    border-color: #CBD5E1;
}

/* ---------- Progress Bars ---------- */
QProgressBar {
    background-color: #E2E8F0;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #059669;
    border-radius: 3px;
}
QProgressBar[level="caution"]::chunk { background-color: #D97706; }
QProgressBar[level="critical"]::chunk { background-color: #DC2626; }

/* ---------- Tables ---------- */
QTableWidget {
    background-color: transparent;
    border: none;
    gridline-color: #E2E8F0;
    color: #1E293B;
    font-size: 13px;
    selection-background-color: #EEF2F7;
}
QTableWidget::item {
    border-bottom: 1px solid #E2E8F0;
    padding: 6px;
    background: transparent;
}
QHeaderView::section {
    background-color: transparent;
    color: #64748B;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    font-size: 11px;
    font-weight: 700;
    padding: 6px;
}

/* ---------- Scrollbars ---------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 28px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- Telemetry Values ---------- */
#TelemetryValue {
    color: #0F172A;
    font-size: 26px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#TelemetryUnit {
    color: #64748B;
    font-size: 13px;
    font-weight: 500;
    background: transparent;
}
#TelemetryLabel {
    color: #64748B;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}

/* ---------- Vital Display ---------- */
#VitalValue {
    color: #0F172A;
    font-size: 28px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    background: transparent;
}
#VitalLabel {
    color: #64748B;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
    background: transparent;
}
#VitalUnit {
    color: #64748B;
    font-size: 12px;
    background: transparent;
}

/* ---------- Status Indicators ---------- */
#StatusGood {
    color: #059669;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#StatusCaution {
    color: #D97706;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}
#StatusCritical {
    color: #DC2626;
    font-size: 13px;
    font-weight: 700;
    background: transparent;
}

/* ---------- Detection Info Row ---------- */
#DetectRowLabel {
    background-color: transparent;
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
}
#DetectRowValue {
    background-color: transparent;
    color: #0F172A;
    font-size: 13px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
#SliderLabel {
    background-color: transparent;
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
}
#SliderValue {
    background-color: transparent;
    color: #0077CC;
    font-size: 12px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
    min-width: 46px;
}

/* ---------- Misc ---------- */
.TextMuted  { color: #64748B; }
.TextAccent { color: #0077CC; }
.TextGood   { color: #059669; }
.TextWarn   { color: #D97706; }
.TextBad    { color: #DC2626; }

QToolTip {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    padding: 8px;
    font-size: 12px;
}

/* ---------- Compact Action Buttons (Live Video) ---------- */
QPushButton[class="CompactAction"] {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 10px;
    min-height: 30px;
}
QPushButton[class="CompactAction"]:hover {
    border-color: #0077CC;
    color: #0F172A;
    background-color: #EFF8FF;
}
QPushButton[class="CompactAction"][active="true"] {
    background-color: #ECFDF5;
    border-color: #059669;
    color: #059669;
}

/* ---------- Pause / Play Overlay Button ---------- */
QPushButton#PauseOverlay {
    background-color: rgba(255, 255, 255, 180);
    border: 1px solid rgba(203, 213, 225, 200);
    border-radius: 7px;
    color: #0F172A;
    font-size: 14px;
    font-weight: 700;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
}
QPushButton#PauseOverlay:hover {
    background-color: rgba(238, 242, 247, 220);
    border-color: #0077CC;
}

/* ---------- Detection Metric Cards ---------- */
#MetricSummaryCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-left: 3px solid #0077CC;
    border-radius: 7px;
}
#MetricSummaryTitle {
    background-color: transparent;
    color: #64748B;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.4px;
}
#MetricSummaryValue {
    background-color: transparent;
    color: #0F172A;
    font-size: 18px;
    font-weight: 700;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
#MetricSummarySub {
    background-color: transparent;
    color: #94A3B8;
    font-size: 10px;
    font-weight: 500;
}

/* ---------- Message Center ---------- */
#MessageCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}
#MessageCardTitle {
    background-color: transparent;
    color: #475569;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.6px;
}
#MessageItem {
    background-color: #F8FAFC;
    border: none;
    border-radius: 4px;
}
#MessageItemLatest {
    background-color: #EFF8FF;
    border: 1px solid #0077CC;
    border-radius: 4px;
}
#MessageText {
    background-color: transparent;
    color: #475569;
    font-size: 11px;
    font-weight: 500;
}
#MessageTextLatest {
    background-color: transparent;
    color: #0F172A;
    font-size: 11px;
    font-weight: 600;
}

/* ---------- System Status Card ---------- */
#SystemStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}
#SystemStatusLabel {
    background-color: transparent;
    color: #64748B;
    font-size: 12px;
    font-weight: 500;
}
#SystemStatusValue {
    background-color: transparent;
    font-size: 12px;
    font-weight: 700;
}

/* ---------- Surgery Notes ---------- */
QTextEdit#SurgeryNotes {
    background-color: #F8FAFC;
    color: #1E293B;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    padding: 10px;
    font-size: 13px;
    font-family: "Inter", "Segoe UI", sans-serif;
    selection-background-color: #0077CC;
}
QTextEdit#SurgeryNotes:focus {
    border-color: #0077CC;
}

/* ---------- Sidebar Section Title ---------- */
#SidebarSectionTitle {
    background-color: transparent;
    color: #94A3B8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

/* ---------- Foot Pedal Flat Buttons ---------- */
QPushButton[class="FlatPedal"] {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 7px;
    color: #475569;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
    min-height: 34px;
    letter-spacing: 0.3px;
}
QPushButton[class="FlatPedal"]:hover {
    border-color: #94A3B8;
    color: #0F172A;
    background-color: #E2E8F0;
}
QPushButton[class="FlatPedal"][active="true"] {
    background-color: #ECFDF5;
    border-color: #059669;
    color: #059669;
}
QPushButton[class="FlatPedalCoag"] {
    background-color: #FFFBEB;
    border: 1px solid #D97706;
    border-radius: 7px;
    color: #D97706;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 14px;
    min-height: 34px;
}
QPushButton[class="FlatPedalCoag"]:hover {
    border-color: #B45309;
    background-color: #FEF3C7;
}
QPushButton[class="FlatPedalCoag"][active="true"] {
    background-color: #D97706;
    color: #FFFFFF;
}

/* ═══════════════════════════════════════════════
   PRE-OP IMAGING WORKSPACE STYLES (light)
   ═══════════════════════════════════════════════ */

#ScanSelectorContainer {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
}

QPushButton[class="ScanTab"] {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #64748B;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 20px;
    letter-spacing: 0.5px;
    min-height: 34px;
}
QPushButton[class="ScanTab"]:hover {
    color: #1E293B;
    background-color: #E2E8F0;
}
QPushButton[class="ScanTab"][active="true"] {
    background-color: #0077CC;
    color: #FFFFFF;
    font-weight: 700;
}

#MedicalViewer {
    background-color: #111827;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}

QPushButton[class="ViewerControl"] {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 5px;
    color: #475569;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    min-height: 28px;
}
QPushButton[class="ViewerControl"]:hover {
    border-color: #0077CC;
    color: #0F172A;
    background-color: #EFF8FF;
}

QPushButton[class="LoadImageButton"] {
    background-color: #EFF8FF;
    border: 1px solid #0077CC;
    border-radius: 6px;
    color: #0077CC;
    font-size: 12px;
    font-weight: 700;
    padding: 7px 16px;
    min-height: 32px;
    letter-spacing: 0.3px;
}
QPushButton[class="LoadImageButton"]:hover {
    background-color: #0077CC;
    color: #FFFFFF;
}

#DermoscopicViewer {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
}

#InfoSectionTitle {
    color: #94A3B8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.2px;
    background: transparent;
}
#InfoSectionCard {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    border-left: 2px solid #CBD5E1;
}

#ImageStatusLabel {
    color: #059669;
    font-size: 11px;
    font-weight: 600;
    background: transparent;
}
#ImageStatusLabelIdle {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

#ViewerModalityTitle {
    color: #0077CC;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
#ViewerMetaLabel {
    color: #94A3B8;
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

/* ═══════════════════════════════════════════════
   LIVE STATUS SECTION (Live Video left panel)
   ═══════════════════════════════════════════════ */
#LiveStatusSection {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 7px;
}
#LiveStatusTitle {
    color: #94A3B8;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    background: transparent;
}
